{
  "name": "@mxspl/nestjs-common",
  "version": "0.2.0",
  "description": "Reusable common helpers for NestJS services.",
  "author": {
    "name": "Maxspell",
    "email": "hello@maxspell.com",
    "url": "https://maxspell.com"
  },
  "keywords": [
    "nestjs",
    "graphql",
    "typeorm",
    "relay",
    "pagination",
    "filters"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "biome check --write .",
    "release": "pnpm dlx standard-version && git push --follow-tags origin main && npm publish"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/graphql": "^13.0.0 || ^14.0.0",
    "graphql": "^16.0.0 || ^17.0.0",
    "reflect-metadata": "^0.2.0",
    "typeorm": "^0.3.0 || ^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@nestjs/common": "^12.0.1",
    "@nestjs/graphql": "^14.0.0",
    "@types/node": "^24.12.4",
    "@vitest/coverage-v8": "^4.1.2",
    "graphql": "^17.0.2",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  }
}
